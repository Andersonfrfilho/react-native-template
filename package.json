{
  "name": "reactnativetemplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "detox:test:debug:ios": "detox test --configuration ios.simulator.debug",
    "detox:test:release:ios": "detox test --configuration ios.simulator.release",
    "detox:build:debug:ios": "detox build --configuration ios.simulator.debug",
    "detox:build:release:ios": "detox build --configuration ios.simulator.release",
    "detox:test:debug:android": "detox test --configuration android.emulator.debug",
    "detox:test:release:android": "detox test --configuration android.emulator.release",
    "detox:build:debug:android": "detox build --configuration android.emulator.debug",
    "detox:build:release:android": "detox build --configuration android.emulator.release"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.78.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.3",
    "@react-native/eslint-config": "0.78.3",
    "@react-native/metro-config": "0.78.3",
    "@react-native/typescript-config": "^0.78.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.8",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.40.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}